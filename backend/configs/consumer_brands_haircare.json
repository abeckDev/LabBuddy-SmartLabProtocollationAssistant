  "sop_suggestions": [
    {
      "keywords": ["foam", "schaum", "schaumvolumen", "ross-miles", "foam height", "foam volume", "lather"],
      "sop_id": "SOP-LAB-2024-011",
      "title": "Shampoo Foam Volume Test (Ross-Miles Method)",
      "description": "Standard procedure for measuring foam volume and stability of shampoo formulations using the Ross-Miles apparatus at 40 °C.",
      "version": "2.0",
      "department": "Hair Care R&D"
    },
    {
      "keywords": ["combing", "kämmen", "kämmkraft", "combing force", "wet comb", "dry comb", "detangling", "entwirren"],
      "sop_id": "SOP-LAB-2023-027",
      "title": "Wet & Dry Combing Force Measurement",
      "description": "Measures wet and dry combing forces on hair tresses using an Instron tensile tester to evaluate conditioning performance.",
      "version": "1.6",
      "department": "Hair Care R&D"
    },
    {
      "keywords": ["color", "farbe", "haarfarbe", "hair dye", "coloration", "färbung", "wash fastness", "waschechtheit"],
      "sop_id": "SOP-LAB-2024-038",
      "title": "Hair Color Fastness and Wash Resistance Testing",
      "description": "Protocol for evaluating color deposit, shade accuracy, and wash resistance of hair colorants over 20 wash cycles.",
      "version": "1.3",
      "department": "Hair Color Innovation"
    },
    {
      "keywords": ["sensory", "sensorik", "panel", "touch", "feel", "griffgefühl", "fragrance", "duft", "texture", "textur"],
      "sop_id": "SOP-LAB-2022-045",
      "title": "Sensory Panel Evaluation for Hair Care Products",
      "description": "Structured sensory panel evaluation protocol covering texture, lather quality, rinsability, wet feel, dry feel, and fragrance perception.",
      "version": "3.2",
      "department": "Consumer Insights & Sensory"
    },
    {
      "keywords": ["surfactant", "tensid", "mild", "cleansing", "reinigung", "irritation", "gentle", "sulfate-free", "sulfatfrei"],
      "sop_id": "SOP-LAB-2024-052",
      "title": "Surfactant System Optimization for Mild Cleansing",
      "description": "Procedure for optimizing surfactant blends (SLES, cocamidopropyl betaine, etc.) for mild cleansing with minimized skin irritation.",
      "version": "1.4",
      "department": "Hair Care R&D"
    },
    {
      "keywords": ["stability", "stabilität", "aging", "alterung", "shelf", "lagerung", "emulsion", "separation", "trennung"],
      "sop_id": "SOP-LAB-2023-063",
      "title": "Accelerated Stability Testing — Hair Care Emulsions",
      "description": "Protocol for accelerated ageing studies of hair care emulsions at 40 °C/75 % RH, 50 °C, and freeze-thaw cycling over 12 weeks.",
      "version": "2.1",
      "department": "Quality Assurance"
    }
  ],

