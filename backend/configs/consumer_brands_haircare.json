{
  "profile_name": {
    "de": "Consumer Brands — Haarpflege",
    "en": "Consumer Brands — Hair Care"
  },
  "company": "Your Organization — Consumer Brands",
  "division": "Hair Care",
  "brand_color": "#0078D4",

  "lims": {
    "name": "LIMS",
    "url_template": "https://lims.example.com/protocols/{protocol_id}"
  },

  "extraction_fields": {
    "researcherName": {
      "type": "string",
      "description": {
        "de": "Vollständiger Name des Forschers/der Forscherin",
        "en": "Full name of the researcher"
      }
    },
    "researcherId": {
      "type": "string",
      "description": {
        "de": "Mitarbeiter-ID oder Personalnummer",
        "en": "Employee ID or personnel number"
      }
    },
    "projectName": {
      "type": "string",
      "description": {
        "de": "Name des Forschungsprojekts",
        "en": "Name of the research project"
      }
    },
    "projectCode": {
      "type": "string",
      "description": {
        "de": "Projektcode oder interne Referenznummer",
        "en": "Project code or internal reference number"
      }
    },
    "experimentTitle": {
      "type": "string",
      "description": {
        "de": "Titel des Experiments",
        "en": "Title of the experiment"
      }
    },
    "experimentType": {
      "type": "string",
      "enum": ["Formulierung", "Sensorik", "Stabilitaetstest", "Farbtest", "Wirksamkeitstest", "Qualitaetskontrolle", "Sonstiges"],
      "description": {
        "de": "Art des Experiments: Formulierung, Sensorik, Stabilitätstest, Farbtest, Wirksamkeitstest, Qualitätskontrolle, Sonstiges",
        "en": "Type of experiment: Formulation, Sensory, Stability Test, Color Test, Efficacy Test, Quality Control, Other"
      }
    },
    "experimentDate": {
      "type": "string",
      "description": {
        "de": "Datum des Experiments (TT.MM.JJJJ)",
        "en": "Date of the experiment (DD.MM.YYYY)"
      }
    },
    "laboratory": {
      "type": "string",
      "description": {
        "de": "Bezeichnung des Labors oder Laborraums",
        "en": "Laboratory name or room designation"
      }
    },
    "equipment": {
      "type": "string",
      "description": {
        "de": "Verwendete Geräte und Instrumente (z.B. Viskosimeter, pH-Meter, Schaumtester)",
        "en": "Equipment and instruments used (e.g., viscometer, pH meter, foam tester)"
      }
    },
    "ingredients": {
      "type": "string",
      "description": {
        "de": "Liste der Inhaltsstoffe mit INCI-Namen und Prozentanteilen",
        "en": "List of ingredients with INCI names and percentages"
      }
    },
    "ingredientSource": {
      "type": "string",
      "description": {
        "de": "Herkunft/Lieferant der Hauptinhaltsstoffe",
        "en": "Source/supplier of key ingredients"
      }
    },
    "sampleId": {
      "type": "string",
      "description": {
        "de": "Proben-ID oder Probenbezeichnung",
        "en": "Sample ID or sample designation"
      }
    },
    "batchNumber": {
      "type": "string",
      "description": {
        "de": "Chargennummer des Experiments",
        "en": "Batch number of the experiment"
      }
    },
    "targetFormulation": {
      "type": "string",
      "description": {
        "de": "Zielformulierung oder Rezeptur (Zusammensetzung in %)",
        "en": "Target formulation or recipe (composition in %)"
      }
    },
    "productType": {
      "type": "string",
      "enum": ["Shampoo", "Conditioner", "Haarfarbe", "Styling", "Haarkur", "Sonstiges"],
      "description": {
        "de": "Produkttyp: Shampoo, Conditioner, Haarfarbe, Styling, Haarkur, Sonstiges",
        "en": "Product type: Shampoo, Conditioner, Hair Color, Styling, Treatment, Other"
      }
    },
    "hairType": {
      "type": "string",
      "description": {
        "de": "Getesteter Haartyp (glatt, wellig, lockig, kraus, coloriert, geschädigt)",
        "en": "Hair type tested (straight, wavy, curly, coily, colored, damaged)"
      }
    },
    "applicationMethod": {
      "type": "string",
      "description": {
        "de": "Anwendungsmethode (z.B. nasses Haar, aufschäumen, einwirken lassen)",
        "en": "Application method (e.g., wet hair, lather, leave-in)"
      }
    },
    "procedureSteps": {
      "type": "string",
      "description": {
        "de": "Durchführungsschritte des Experiments in chronologischer Reihenfolge",
        "en": "Procedure steps of the experiment in chronological order"
      }
    },
    "temperatureCelsius": {
      "type": "number",
      "description": {
        "de": "Temperatur in °C während des Experiments",
        "en": "Temperature in °C during the experiment"
      }
    },
    "duration": {
      "type": "string",
      "description": {
        "de": "Dauer des Experiments (z.B. 2 Stunden, 30 Minuten)",
        "en": "Duration of the experiment (e.g., 2 hours, 30 minutes)"
      }
    },
    "phValue": {
      "type": "number",
      "description": {
        "de": "Gemessener pH-Wert",
        "en": "Measured pH value"
      }
    },
    "viscosity": {
      "type": "string",
      "description": {
        "de": "Gemessene Viskosität (Wert und Einheit, z.B. 3000 mPa·s)",
        "en": "Measured viscosity (value and unit, e.g., 3000 mPa·s)"
      }
    },
    "foamVolume": {
      "type": "string",
      "description": {
        "de": "Schaumvolumen/-höhe (ml oder cm, z.B. nach Ross-Miles-Methode)",
        "en": "Foam volume/height (ml or cm, e.g., per Ross-Miles method)"
      }
    },
    "sensoryEvaluation": {
      "type": "string",
      "description": {
        "de": "Sensorische Bewertung: Textur, Griffgefühl, Duft, Nachgefühl",
        "en": "Sensory evaluation: texture, feel, fragrance, after-feel"
      }
    },
    "conditioningEffect": {
      "type": "string",
      "description": {
        "de": "Konditionierungseffekt: Nass-/Trockenkämmkraft, Glätte-Bewertung",
        "en": "Conditioning effect: wet/dry combing force, smoothness rating"
      }
    },
    "colorResult": {
      "type": "string",
      "description": {
        "de": "Farbergebnis: Nuance, Abdeckung, Gleichmäßigkeit (bei Haarfärbe-Experimenten)",
        "en": "Color result: shade, coverage, uniformity (for hair color experiments)"
      }
    },
    "fragranceProfile": {
      "type": "string",
      "description": {
        "de": "Duftprofil: Duftnoten und Intensitätsbewertung",
        "en": "Fragrance profile: fragrance notes and intensity rating"
      }
    },
    "stabilityConditions": {
      "type": "string",
      "description": {
        "de": "Stabilitätsbedingungen: Lagerbedingungen für Stabilitätsprüfung",
        "en": "Stability conditions: storage conditions for stability assessment"
      }
    },
    "observations": {
      "type": "string",
      "description": {
        "de": "Beobachtungen während des Experiments (Farbe, Konsistenz, Geruch, Auffälligkeiten)",
        "en": "Observations during the experiment (color, consistency, odor, anomalies)"
      }
    },
    "result": {
      "type": "string",
      "description": {
        "de": "Ergebnis des Experiments (bestanden/nicht bestanden, Messwerte)",
        "en": "Result of the experiment (pass/fail, measurements)"
      }
    },
    "deviations": {
      "type": "string",
      "description": {
        "de": "Abweichungen vom Standard-Protokoll oder SOP",
        "en": "Deviations from standard protocol or SOP"
      }
    },
    "safetyNotes": {
      "type": "string",
      "description": {
        "de": "Sicherheitshinweise oder besondere Vorsichtsmaßnahmen",
        "en": "Safety notes or special precautions"
      }
    },
    "nextSteps": {
      "type": "string",
      "description": {
        "de": "Geplante nächste Schritte oder Folgeexperimente",
        "en": "Planned next steps or follow-up experiments"
      }
    },
    "comments": {
      "type": "string",
      "description": {
        "de": "Freitext für zusätzliche Anmerkungen",
        "en": "Free text for additional comments"
      }
    }
  },

  "required_fields": [
    "researcherName", "experimentTitle", "experimentType", "experimentDate",
    "ingredients", "procedureSteps", "result"
  ],

