# ── Local development only ──────────────────────────────────────────────────
# These variables are NOT needed when deploying with `azd up` (Bicep sets them automatically).
# Alternatively, you can enter these in the ⚙️ Settings panel inside the app.

# Azure AI Services endpoint (required for local dev — Voice Live + OpenAI extraction agent)
AZURE_VOICELIVE_ENDPOINT=https://your-ai-services.cognitiveservices.azure.com/

# API key for Azure AI Services (optional — leave empty to use `az login` / DefaultAzureCredential)
AZURE_VOICELIVE_API_KEY=

# Azure OpenAI endpoint for extraction agent (optional — defaults to AZURE_VOICELIVE_ENDPOINT)
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI deployment name for the extraction agent
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Blob Storage endpoint (optional — for persisting experiment protocol artifacts)
AZURE_STORAGE_ENDPOINT=

# Voice Live model (fully managed — no deployment needed)
VOICELIVE_MODEL=gpt-4o

# TTS voice name
VOICELIVE_VOICE=de-DE-SeraphinaMultilingualNeural

# Default demo configuration profile (adhesive_technologies or consumer_brands_haircare)
DEMO_CONFIG=adhesive_technologies
